# .envrc — versionado (sem segredo). Gerado pela skill env-conventions (padrão ORAEX).
# Requer direnv (`direnv allow` após salvar).

# Identidade POR-DEV: ORAEX_DEV_ID vem do .envrc.local (gitignored, por máquina),
# não deste arquivo versionado — senão todo dev herdaria o mesmo handle e brigaria
# no merge. Copie .envrc.local.example -> .envrc.local e ponha o SEU handle.
source_env_if_exists .envrc.local

export AWS_PROFILE="${AWS_PROFILE:-<AWS_PROFILE>}"   # profile SSO (ex.: oraex-dev / AWSDeveloperAccess)
export AWS_REGION="${AWS_REGION:-<AWS_REGION>}"      # ex.: sa-east-1

if [ -z "${ORAEX_DEV_ID:-}" ]; then
  echo "env-conventions: ORAEX_DEV_ID não definido — copie .envrc.local.example para .envrc.local e ponha o seu handle." >&2
fi

# Segredos de MCP env-sourced: puxados do SSM Parameter Store (não repousam em arquivo).
# Uma linha por servidor que use token. Requer: aws sso login --profile "$AWS_PROFILE".
# Só chama o SSM se houver handle — sem ORAEX_DEV_ID o nome do parâmetro seria inválido.
if [ -n "${ORAEX_DEV_ID:-}" ]; then
  if GITHUB_PAT="$(aws ssm get-parameter --name "/oraex/dev/$ORAEX_DEV_ID/mcp/github" \
      --with-decryption --query 'Parameter.Value' --output text \
      --region "$AWS_REGION" --profile "$AWS_PROFILE" 2>/dev/null)"; then
    export GITHUB_PAT
  else
    echo "env-conventions: falha ao ler GITHUB_PAT do SSM — rode: aws sso login --profile $AWS_PROFILE" >&2
  fi
fi

# segredos ainda fora do Parameter Store: mantenha em .env.local (gitignored)
dotenv_if_exists .env.local
