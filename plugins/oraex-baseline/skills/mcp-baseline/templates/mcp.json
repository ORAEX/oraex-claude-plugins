{
  "mcpServers": {
    "supabase-local": {
      "type": "http",
      "url": "http://localhost:<API_PORT>/mcp"
    },
    "supabase-prd": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=<PRD_PROJECT_REF>&read_only=true"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    }
  }
}
